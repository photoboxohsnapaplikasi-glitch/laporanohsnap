# ============================================================================
# .env.example — Konfigurasi Environment Oh Snap! Photobox (5 Cabang)
# Salin file ini menjadi .env:
#   cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. KONFIGURASI SERVER & APLIKASI
# ----------------------------------------------------------------------------
APP_NAME="Oh Snap! Photobox - Sistem Operasional 5 Cabang"
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
TIMEZONE=Asia/Jakarta

# ----------------------------------------------------------------------------
# 2. KONFIGURASI DATABASE (MySQL / PostgreSQL / SQLite)
# ----------------------------------------------------------------------------
# Pilihan DB_CLIENT: sqlite | mysql | postgres
DB_CLIENT=sqlite
SQLITE_PATH=./backend/storage/ohsnap_photobox.sqlite

# Jika menggunakan MySQL / MariaDB / PostgreSQL:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_ohsnap_photobox_5cabang
DB_USER=root
DB_PASSWORD=

# ----------------------------------------------------------------------------
# 3. INTEGRASI GOOGLE APPS SCRIPT & GOOGLE DRIVE (5 CABANG)
# ----------------------------------------------------------------------------
GAS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbzWDRLo5bMNHWQeNIkoNXwan67TxgsjSdPow_ZVxVc7AwDHTJxz68l5mj18-sFGbvJh/exec
SPREADSHEET_ID_PUSAT=1YuG4fd5DzIbgye0i7DzTzugqtj_rDlap5-6a4qizLik
GOOGLE_DRIVE_FOLDER_ID=1YPsH4RmsrfPdqFZUN5A2vmszt_ZyKvUH

# ID Spreadsheet Masing-Masing Cabang (Kosongkan jika menggunakan mode AUTO-CREATE)
BRANCH_SS_MAJENANG=
BRANCH_SS_CILACAP=
BRANCH_SS_PEKALONGAN=
BRANCH_SS_PEMALANG=
BRANCH_SS_KEDIRI=

# ----------------------------------------------------------------------------
# 4. KEAMANAN & AKSES ADMIN
# ----------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
CORS_ORIGIN=*
MAX_UPLOAD_SIZE_MB=25
